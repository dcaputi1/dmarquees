# dmarquees-netbridge environment options
# protocol: tcp
DMARQUEES_PROTOCOL=tcp

# bind host and port on the Pi3
DMARQUEES_HOST=0.0.0.0
DMARQUEES_PORT=5533

# local FIFO consumed by dmarquees
DMARQUEES_FIFO=/tmp/dmarquees_cmd

# Art zip paths and FUSE mount point (used by SWAPART command)
DMARQUEES_MARQUEES_ZIP=/home/danc/MAME_0.256_EXTRAs/marquees.zip
DMARQUEES_CPANEL_ZIP=/home/danc/MAME_0.256_EXTRAs/cpanel.zip
DMARQUEES_MARQUEES_MNT=/home/danc/mnt/marquees
# File that tracks which zip is currently mounted (written automatically at runtime)
DMARQUEES_MOUNT_STATE=/tmp/dmarquees_mount_state
