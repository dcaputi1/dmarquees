[Unit]
Description=Mount dmarquees artwork zip via fuse-zip
After=local-fs.target
Before=dmarquees-daemon.service

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=-/etc/default/dmarquees-mount
ExecStart=/usr/bin/env bash -lc 'set -euo pipefail; user="${DMARQUEES_USER:-danc}"; zip="${DMARQUEES_ZIP:-/home/${user}/MAME_0.256_EXTRAs/marquees.zip}"; mnt="${DMARQUEES_MNT:-/home/${user}/mnt/marquees}"; mkdir -p "$mnt"; if mountpoint -q "$mnt"; then fusermount -u "$mnt" || /bin/umount -f "$mnt"; fi; grep -q "^user_allow_other" /etc/fuse.conf 2>/dev/null || echo "user_allow_other" >> /etc/fuse.conf; fuse-zip -r -o allow_other "$zip" "$mnt"'
ExecStop=/usr/bin/env bash -lc 'set -euo pipefail; user="${DMARQUEES_USER:-danc}"; mnt="${DMARQUEES_MNT:-/home/${user}/mnt/marquees}"; if mountpoint -q "$mnt"; then fusermount -u "$mnt" || /bin/umount -f "$mnt"; fi'

[Install]
WantedBy=multi-user.target
