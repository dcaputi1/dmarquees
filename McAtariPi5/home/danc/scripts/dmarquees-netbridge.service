[Unit]
Description=dmarquees network bridge (TCP/UDP -> FIFO)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=-/etc/default/dmarquees-netbridge
ExecStart=/usr/bin/env python3 /usr/local/bin/dmarquees-netbridge.py --protocol ${DMARQUEES_PROTOCOL} --host ${DMARQUEES_HOST} --port ${DMARQUEES_PORT} --fifo ${DMARQUEES_FIFO}
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
